---
interface Wish {
  name: string;
  completed: boolean;
}

interface Props {
  number: string;
  title: string;
  subtitle: string;
  items: Wish[];
  position: number;
}

const { number, title, subtitle, items, position } = Astro.props;
const unlockedCount = items.filter((item) => item.completed).length;
const rarity = ['Common', 'Rare', 'Legendary'][position - 1] ?? 'Reward';
---

<section class:list={['wish-level', `level-${position}`]} aria-labelledby={`level-${number}`}>
  <header class="level-heading">
    <div class="level-copy">
      <div class="level-meta">
        <span>Level {number}</span>
        <span class="rarity">{rarity}</span>
      </div>
      <div class="level-title-row">
        <h2 id={`level-${number}`}>{title}</h2>
        <span class="level-count">{unlockedCount}/{items.length} unlocked</span>
      </div>
      <p class="level-subtitle">{subtitle}</p>
    </div>
  </header>

  <ol class="wish-list">
    {items.map((item, index) => (
      <li class="wish-item" data-completed={item.completed || undefined}>
        <span class="wish-cursor" aria-hidden="true">▶</span>
        <span class="wish-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="wish-name">{item.name}</span>
        <span class:list={['reward-status', { unlocked: item.completed }]}>
          {item.completed && <span aria-hidden="true">★</span>}
          {item.completed ? 'Unlocked' : 'Locked'}
        </span>
      </li>
    ))}
  </ol>
</section>

<style>
  .wish-level {
    margin-bottom: 2rem;
    border: 1px solid var(--line);
    background: var(--bg);
    box-shadow: 4px 4px 0 var(--line);
  }

  .level-heading {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }

  .level-copy {
    padding: 1rem 1.15rem;
  }

  .level-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    width: 100%;
    margin-bottom: .35rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .6rem;
    font-weight: 650;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .rarity {
    color: var(--accent);
  }

  .level-2 .rarity {
    color: var(--highlight);
  }

  .level-3 .rarity {
    color: var(--text);
  }

  .level-title-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    width: 100%;
  }

  h2 {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1.15rem;
    letter-spacing: .03em;
    text-transform: uppercase;
  }

  .level-count {
    flex: 0 0 auto;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .64rem;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .level-subtitle {
    margin: .25rem 0 0;
    color: var(--muted);
    font-size: .83rem;
    white-space: nowrap;
  }

  .wish-list {
    margin: 0;
    padding: .65rem;
    list-style: none;
  }

  .wish-item {
    display: grid;
    grid-template-areas: 'cursor number name status';
    grid-template-columns: .65rem 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: .7rem;
    min-height: 3rem;
    padding: .45rem .55rem;
  }

  .wish-cursor {
    grid-area: cursor;
    color: var(--accent);
    font-size: .55rem;
    opacity: .18;
  }

  .wish-number {
    grid-area: number;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .66rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .06em;
  }

  .wish-name {
    grid-area: name;
    width: 100%;
    font-size: .94rem;
    line-height: 1.4;
    text-align: left;
  }

  .reward-status {
    grid-area: status;
    justify-self: end;
    min-width: 5.5rem;
    padding: .18rem .4rem;
    border: 1px solid var(--line);
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .58rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: .1em;
    text-align: center;
    text-transform: uppercase;
  }

  .reward-status.unlocked {
    border-color: var(--highlight);
    color: var(--highlight);
    box-shadow: 2px 2px 0 var(--line);
  }

  .wish-item[data-completed] .wish-name {
    color: var(--text);
    font-weight: 600;
  }

  @media (hover: hover) {
    .wish-item {
      transition: color 120ms steps(2, end), background-color 120ms steps(2, end);
    }

    .wish-item:hover {
      color: var(--accent);
      background: var(--surface);
    }

    .wish-item:hover .wish-cursor {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wish-item {
      transition: none;
    }
  }

  @media (max-width: 36rem) {
    .level-copy {
      padding: .85rem;
    }

    .wish-item {
      grid-template-areas: 'cursor number name status';
      grid-template-columns: .55rem 1.35rem minmax(0, 1fr) auto;
      gap: .4rem .6rem;
      padding: .55rem .35rem;
    }

    .reward-status {
      min-width: 4.5rem;
      padding-inline: .25rem;
      font-size: .52rem;
    }

    .wish-cursor {
      opacity: .45;
    }
  }
</style>
