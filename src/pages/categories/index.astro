---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryPath, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const categories = ['Brain & Focus', 'Development', 'Life'];
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout title="Categories" description="Browse Second Pass by category.">
  <section class="page-heading">
    <p class="eyebrow">Browse notes</p>
    <h1>Categories</h1>
  </section>
  <ul class="category-index">
    {categories.map((category) => (
      <li>
        <a href={withBase(categoryPath(category))}>{category}</a>
        <span>{posts.filter((post) => post.data.category === category).length} {posts.filter((post) => post.data.category === category).length === 1 ? 'note' : 'notes'}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
