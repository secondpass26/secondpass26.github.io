---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WishlistLevel from '../components/WishlistLevel.astro';

const page = await getEntry('pages', 'wishlist');
if (!page) throw new Error('Missing content file: src/content/pages/wishlist.md');

const { feature_title, feature_intro, wishlist_levels } = page.data;
if (!feature_title || !feature_intro || !wishlist_levels) {
  throw new Error('Wishlist frontmatter is missing its introduction or levels.');
}

const rewardCount = wishlist_levels.reduce((total, level) => total + level.items.length, 0);
const unlockedCount = wishlist_levels.reduce(
  (total, level) => total + level.items.filter((item) => item.completed).length,
  0,
);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="wishlist-page">
    <header class="wishlist-hero">
      <div class="system-bar">
        <span>Reward system</span>
        <span>Save 01</span>
      </div>
      <h1>{page.data.title}</h1>
      <p class="feature-title">{feature_title}</p>
      <p class="feature-intro">{feature_intro}</p>
      <div
        class="reward-progress"
        role="progressbar"
        aria-label="Rewards unlocked"
        aria-valuemin="0"
        aria-valuemax={rewardCount}
        aria-valuenow={unlockedCount}
      >
        <p>Rewards unlocked</p>
        <div class="meter-row">
          <div class="segments" style={`--reward-count: ${rewardCount}`} aria-hidden="true">
            {Array.from({ length: rewardCount }, (_, index) => (
              <span class:list={{ filled: index < unlockedCount }}></span>
            ))}
          </div>
          <strong><span>{unlockedCount}</span> / {rewardCount}</strong>
        </div>
      </div>
    </header>

    <div class="level-sequence">
      {wishlist_levels.map((level, index) => (
        <WishlistLevel {...level} position={index + 1} />
      ))}
    </div>

    <footer class="menu-footer">
      <span>Reward menu // Second Pass</span>
      <span>Keep going. More to unlock.</span>
    </footer>
  </article>
</BaseLayout>

<style>
  .wishlist-page {
    max-width: 48rem;
    padding: 4.5rem 0 3rem;
  }

  .wishlist-hero {
    position: relative;
    margin: 0 0 2.5rem;
    padding: 1.25rem 1.4rem 1.5rem;
    border: 1px solid var(--line);
    background:
      repeating-linear-gradient(0deg, transparent 0, transparent 3px, rgba(127, 127, 127, .035) 3px, rgba(127, 127, 127, .035) 4px),
      var(--surface);
    box-shadow: 4px 4px 0 var(--line);
  }

  .system-bar {
    display: flex;
    justify-content: space-between;
    margin: -1.25rem -1.4rem 1.5rem;
    padding: .45rem .65rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    background: var(--bg);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .6rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .wishlist-hero h1 {
    margin: 0 0 .65rem;
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(2.1rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: -.05em;
    text-transform: uppercase;
  }

  .feature-title {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(1rem, 3vw, 1.35rem);
    line-height: 1.35;
    font-weight: 650;
  }

  .feature-intro {
    max-width: 34rem;
    margin: .65rem 0 0;
    color: var(--muted);
    font-size: .88rem;
    line-height: 1.6;
    text-align: left;
  }

  .reward-progress {
    margin: 1.25rem 0 0;
  }

  .reward-progress p {
    margin: 0 0 .4rem;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .58rem;
    font-weight: 650;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .meter-row {
    display: flex;
    align-items: center;
    gap: .75rem;
  }

  .segments {
    display: grid;
    grid-template-columns: repeat(var(--reward-count, 8), minmax(.35rem, 1fr));
    width: min(100%, 22rem);
    gap: .22rem;
  }

  .segments span {
    height: .55rem;
    border: 1px solid var(--line);
    background: var(--bg);
  }

  .segments span.filled {
    border-color: var(--highlight);
    background: var(--highlight);
  }

  .meter-row strong {
    flex: 0 0 auto;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .66rem;
    font-weight: 500;
  }

  .meter-row strong span {
    color: var(--highlight);
    font-weight: 700;
  }

  .level-sequence {
    position: relative;
  }

  .menu-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.75rem;
    padding: .65rem 0;
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .58rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  @media (max-width: 36rem) {
    .wishlist-page {
      padding-top: 4rem;
    }

    .wishlist-hero {
      padding-inline: 1rem;
    }

    .system-bar {
      margin-inline: -1rem;
    }

    .menu-footer {
      display: block;
    }

    .menu-footer span {
      display: block;
    }

    .menu-footer span + span {
      margin-top: .3rem;
    }
  }
</style>
