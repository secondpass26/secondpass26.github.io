---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WishlistLevel from '../components/WishlistLevel.astro';

const page = await getEntry('pages', 'wishlist');
if (!page) throw new Error('Missing content file: src/content/pages/wishlist.md');

const { feature_title, feature_intro, wishlist_levels } = page.data;
if (!feature_title || !feature_intro || !wishlist_levels) {
  throw new Error('Wishlist frontmatter is missing its introduction or levels.');
}

const rewardCount = wishlist_levels.reduce((total, level) => total + level.items.length, 0);
const unlockedCount = wishlist_levels.reduce(
  (total, level) => total + level.items.filter((item) => item.completed).length,
  0,
);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <article class="wishlist-page">
    <header class="wishlist-hero">
      <div class="system-bar">
        <span>Reward system</span>
        <span>Save 01</span>
      </div>
      <h1>{page.data.title}</h1>
      <p class="feature-title">{feature_title}</p>
      <p class="feature-intro">{feature_intro}</p>
      <p class="save-status"><span>{unlockedCount}</span> / {rewardCount} rewards unlocked</p>
    </header>

    <div class="level-sequence">
      {wishlist_levels.map((level, index) => (
        <WishlistLevel {...level} position={index + 1} />
      ))}
    </div>
  </article>
</BaseLayout>

<style>
  .wishlist-page {
    max-width: 48rem;
    padding: 4.5rem 0 3rem;
  }

  .wishlist-hero {
    position: relative;
    margin: 0 0 2.5rem;
    padding: 1.25rem 1.4rem 1.5rem;
    border: 1px solid var(--line);
    background:
      repeating-linear-gradient(0deg, transparent 0, transparent 3px, rgba(127, 127, 127, .035) 3px, rgba(127, 127, 127, .035) 4px),
      var(--surface);
    box-shadow: 4px 4px 0 var(--line);
  }

  .system-bar {
    display: flex;
    justify-content: space-between;
    margin: -1.25rem -1.4rem 1.5rem;
    padding: .45rem .65rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    background: var(--bg);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .6rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .wishlist-hero h1 {
    margin: 0 0 .65rem;
    color: var(--accent);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(2.1rem, 7vw, 4rem);
    line-height: 1;
    letter-spacing: -.05em;
    text-transform: uppercase;
  }

  .feature-title {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: clamp(1rem, 3vw, 1.35rem);
    line-height: 1.35;
    font-weight: 650;
  }

  .feature-intro {
    max-width: 34rem;
    margin: .65rem 0 0;
    color: var(--muted);
    font-size: .88rem;
    line-height: 1.6;
    text-align: left;
  }

  .save-status {
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: .66rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .save-status span {
    color: var(--highlight);
    font-weight: 700;
  }

  .level-sequence {
    position: relative;
  }

  @media (max-width: 36rem) {
    .wishlist-page {
      padding-top: 4rem;
    }

    .wishlist-hero {
      padding-inline: 1rem;
    }

    .system-bar {
      margin-inline: -1rem;
    }
  }
</style>
