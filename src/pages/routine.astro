---
import { getEntry } from 'astro:content';
import ContentPage from '../components/ContentPage.astro';

const page = await getEntry('pages', 'routine');
if (!page) throw new Error('Missing content file: src/content/pages/routine.md');
---

<div class="routine-page">
  <ContentPage {page} />
</div>

<style>
  .routine-page :global(th:nth-child(2)),
  .routine-page :global(td:nth-child(2)) {
    padding-left: 1.25rem;
  }
</style>
