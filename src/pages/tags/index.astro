---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, tagPath } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout title="Tags" description="Browse Second Pass by tag.">
  <section class="page-heading">
    <p class="eyebrow">Index</p>
    <h1>Tags</h1>
  </section>
  <ul class="tag-index">
    {tags.map((tag) => <li><a href={withBase(tagPath(tag))}>#{tag}</a><span>{posts.filter((post) => post.data.tags.includes(tag)).length}</span></li>)}
  </ul>
</BaseLayout>
